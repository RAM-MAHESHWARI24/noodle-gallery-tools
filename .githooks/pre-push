#!/usr/bin/env bash
# ==============================================================================
# Noodle Gallery Tools - Tier 2 Pre-Push Hook Dispatcher
# Cross-platform runner (Windows bash / Linux / macOS)
# ==============================================================================
set -e

if command -v python3 &>/dev/null; then
    exec python3 .githooks/pre_push.py "$@"
elif command -v python &>/dev/null; then
    exec python .githooks/pre_push.py "$@"
else
    echo "Warning: Python not found in PATH, skipping pre-push hook."
    exit 0
fi
